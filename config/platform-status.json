    },
    {
      "name": "Project directory",
      "status": "IMPLEMENTED",
      "details": "Directory examples are unverified. Authenticated submissions, admin review, and approved-only publication are implemented but require configured Supabase and applied migrations."
    },
    {
      "name": "Wallet sessions",
      "status": "EVM ONLY",
      "details": "EIP-1193 connection, network, native balance, and ERC-20 reads are supported for EVM wallets. Wallets and balances remain independent of KRONOS accounts. Solana and MultiversX wallet adapters are not implemented."
    },
    {
      "name": "User authentication",
      "status": "UNCONFIGURED",
      "details": "Email/password signup, sign-in, and password reset are implemented with Supabase, but SUPABASE_URL and SUPABASE_ANON_KEY are not configured."
    },
    {
      "name": "Spot trading",
      "status": "UNCONFIGURED",
      "details": "No exchange adapter, order API, provider account, sandbox, or order reconciliation service is configured."
    },
    {
      "name": "Token swaps",
      "status": "INCOMPLETE",
      "details": "Provider configuration does not establish quote endpoint health. Transaction execution is not implemented; end-to-end testing and independent production review are incomplete. Execution is disabled."
    },
    {
      "name": "Cross-chain swaps",
      "status": "UNAVAILABLE",
      "details": "Cross-chain routing and destination-delivery verification are not implemented. Same-chain swap support does not imply cross-chain support."
    },
    {
      "name": "Futures and margin",
      "status": "UNCONFIGURED",
      "details": "No supported derivatives or margin provider is selected. Positions, leverage, funding, borrowing, and liquidation data are not available."
    },
    {
      "name": "Deposits and withdrawals",
      "status": "UNAVAILABLE",
      "details": "There is no custody service, financial ledger, deposit address service, or withdrawal approval infrastructure."
    }
